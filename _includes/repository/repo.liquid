<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.repository }}">
    <h4>{{ include.repository | escape }}</h4>
    <img
      src="https://img.shields.io/github/stars/{{ include.repository }}?style=social"
      alt="GitHub stars for {{ include.repository | escape }}"
      loading="lazy"
    >
  </a>
</div>
